generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WhatsAppStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentModality {
  AVISTA
  PARCELADO
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIALLY_PAID
}

enum InstallmentStatus {
  PAID
  PENDING
  OVERDUE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MessageTemplateType {
  CONFIRMATION
  REMINDER_8D
  REMINDER
  REMINDER_2H
  FOLLOWUP
  POST_CONSULTATION
  BIRTHDAY
  REACTIVATION_30
  REACTIVATION_60
  REACTIVATION_90
  WELCOME
  PLAN_RENEWAL
}

enum PatientStage {
  LEAD
  FIRST_CONSULTATION
  ACTIVE
  INACTIVE
  REACTIVATED
}

enum WhatsAppLogStatus {
  SENT
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  priceMonthly  Float
  maxPatients   Int      @default(50)
  maxWhatsApp   Int      @default(500)
  features      String[] @default([])
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String             @unique
  planId      String
  status      SubscriptionStatus @default(TRIAL)
  trialEndsAt DateTime?
  startsAt    DateTime           @default(now())
  expiresAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Tenant {
  id                    String         @id @default(cuid())
  name                  String
  email                 String         @unique
  password              String
  crn                   String
  phone                 String
  clinicName            String?
  whatsappStatus        WhatsAppStatus @default(DISCONNECTED)
  whatsappPhone         String?
  whatsappConnectedAt   DateTime?
  inactiveDaysThreshold Int            @default(30)
  defaultDuration       Int            @default(50)
  workingHours          Json?
  appointmentTypes      String[]       @default([])
  postConsultEnabled    Boolean        @default(false)
  postConsultDayOfWeek  Int            @default(1)
  postConsultDaysAfter  Int            @default(3)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  subscription        Subscription?
  patients            Patient[]
  appointments        Appointment[]
  payments            Payment[]
  installments        Installment[]
  transactions        Transaction[]
  serviceTypes        ServiceType[]
  followUpLogs        FollowUpLog[]
  whatsAppLogs        WhatsAppLog[]
  messageTemplates    MessageTemplate[]
  passwordResetTokens PasswordResetToken[]

  @@map("tenants")
}

model ServiceType {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  defaultPrice Float
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("service_types")
}

model Patient {
  id                String       @id @default(cuid())
  tenantId          String
  name              String
  cpf               String?
  birthDate         DateTime?
  phone             String
  email             String?
  address           String?
  howFoundUs        String?
  notes             String?
  isActive          Boolean      @default(true)
  stage             PatientStage @default(LEAD)
  tags              String[]     @default([])
  referredById      String?
  lastAppointmentAt DateTime?
  lastReactivationAt DateTime?
  postConsultSentAt DateTime?
  birthdaySentYear  Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referredBy   Patient?      @relation("PatientReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    Patient[]     @relation("PatientReferrals")
  appointments Appointment[]
  payments     Payment[]
  followUpLogs FollowUpLog[]
  whatsAppLogs WhatsAppLog[]

  @@map("patients")
}

model Appointment {
  id               String            @id @default(cuid())
  tenantId         String
  patientId        String
  scheduledAt      DateTime
  duration         Int               @default(50)
  status           AppointmentStatus @default(SCHEDULED)
  notes            String?
  consultationType String?
  confirmationSent Boolean           @default(false)
  reminder8dSent   Boolean           @default(false)
  reminder24hSent  Boolean           @default(false)
  reminder2hSent   Boolean           @default(false)
  postConsultSent  Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("appointments")
}

model Payment {
  id               String          @id @default(cuid())
  tenantId         String
  patientId        String
  appointmentId    String?
  serviceTypeId    String
  description      String?
  totalAmount      Float
  discountAmount   Float           @default(0)
  finalAmount      Float
  modality         PaymentModality
  installmentCount Int             @default(1)
  paymentMethod    String
  status           PaymentStatus   @default(PENDING)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  serviceType  ServiceType   @relation(fields: [serviceTypeId], references: [id])
  installments Installment[]

  @@map("payments")
}

model Installment {
  id                String            @id @default(cuid())
  paymentId         String
  tenantId          String
  installmentNumber Int
  amount            Float
  dueDate           DateTime
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("installments")
}

model Transaction {
  id          String          @id @default(cuid())
  tenantId    String
  type        TransactionType
  amount      Float
  description String
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model FollowUpLog {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  contactedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("follow_up_logs")
}

model WhatsAppLog {
  id           String             @id @default(cuid())
  tenantId     String
  patientId    String?
  messageType  String
  phoneNumber  String
  messageText  String
  status       WhatsAppLogStatus
  errorMessage String?
  sentAt       DateTime           @default(now())
  createdAt    DateTime           @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@map("whatsapp_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tenantId  String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model MessageTemplate {
  id        String              @id @default(cuid())
  tenantId  String
  type      MessageTemplateType
  content   String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@map("message_templates")
}

model HotmartPurchase {
  id            String    @id @default(cuid())
  email         String
  planName      String
  offerCode     String?
  transactionId String?   @unique
  event         String
  activatedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@map("hotmart_purchases")
}
